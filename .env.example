# TG Booster API — формат ключа: {account_id}|{secret}
TG_BOOSTER_API_TOKEN=
TG_BOOSTER_API_BASE_URL=https://api.tgbooster.ru
# Пусто = все кабинеты; через запятую = выбранные
TG_BOOSTER_ACCOUNT_ID=

# PostgreSQL
# Локально:  postgresql://etl:etl_local@localhost:5432/tg_booster
# Удалённо:  postgresql://etl:ПАРОЛЬ@хост:5432/tg_booster
DATABASE_URL=postgresql://etl:etl_local@localhost:5432/tg_booster

LOG_LEVEL=INFO
