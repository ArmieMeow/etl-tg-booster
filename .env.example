# TG Booster API — key format: {account_id}|{secret}
TG_BOOSTER_API_TOKEN=
TG_BOOSTER_API_BASE_URL=https://api.tgbooster.ru
# Leave empty to load all cabinets; comma-separated for subset
TG_BOOSTER_ACCOUNT_ID=

# PostgreSQL
# Local:  postgresql://etl:etl_local@localhost:5432/tg_booster
# Remote: postgresql://etl:PASSWORD@your-host:5432/tg_booster
DATABASE_URL=postgresql://etl:etl_local@localhost:5432/tg_booster

LOG_LEVEL=INFO
